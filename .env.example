# Supabase project (Settings > API). The anon key is safe in the browser; RLS protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Face models are served from /models (copied from node_modules on install). Override to use a CDN.
VITE_FACE_MODEL_BASE=/models/
# Map tiles (OpenStreetMap by default — respect its tile usage policy or use your own provider)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# NEVER put the service-role key in any VITE_ variable.
